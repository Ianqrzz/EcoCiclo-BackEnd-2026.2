{
  "info": {
    "name": "EcoCiclo API",
    "_postman_id": "ecociclo-api-v1",
    "description": "EcoCiclo Backend — ambiente de testes local.\n\nAdmin padrao: admin@ecociclo.com / password\n\nExecute a pasta Auth primeiro. O token e os IDs sao salvos automaticamente nas variaveis da colecao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080", "type": "string" },
    { "key": "token",         "value": "",                      "type": "string" },
    { "key": "usuarioId",     "value": "",                      "type": "string" },
    { "key": "doadorId",      "value": "",                      "type": "string" },
    { "key": "coletorId",     "value": "",                      "type": "string" },
    { "key": "enderecoId",    "value": "",                      "type": "string" },
    { "key": "associacaoId",  "value": "",                      "type": "string" },
    { "key": "doacaoId",      "value": "",                      "type": "string" },
    { "key": "agendamentoId", "value": "",                      "type": "string" },
    { "key": "avaliacaoId",   "value": "",                      "type": "string" },
    { "key": "recompensaId",  "value": "",                      "type": "string" },
    { "key": "resgateId",     "value": "",                      "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set(\"token\", res.token);",
                  "    console.log(\"Token salvo:\", res.token.substring(0, 20) + \"...\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecociclo.com\",\n  \"senha\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "usuarios", "login"]
            }
          },
          "response": []
        }
      ]
    },
